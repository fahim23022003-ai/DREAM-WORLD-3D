extends SceneTree
const H=preload("res://scripts/home_rules.gd")
const L=preload("res://scripts/cozy_story_rules.gd")
const N=preload("res://scripts/neighborhood_rules.gd")
var checks:=0
var failures:=0
func check(ok: bool,text: String) -> void:
 checks+=1
 if ok: print("PASS ",text)
 else: failures+=1;push_error("FAIL "+text)
func _initialize() -> void:
 var h:=H.new();var home: Dictionary=h.data
 check(not L.begin(home,"warming"),"housewarming has an honest preparation prerequisite")
 check(L.begin(home,"baking") and home.life.arcs.baking==1,"optional baking story begins")
 check(not L.begin(home,"baking"),"story introduction cannot restart")
 L.observe(home,"meal",{"recipe":"berry_cupcakes"})
 check(home.life.arcs.baking==1,"baking out of chapter order cannot skip ingredient gathering")
 home.neighborhood.produce.strawberry=1;L.observe(home,"harvest",{"crop":"strawberry"})
 check(home.life.arcs.baking==2 and home.neighborhood.produce.strawberry==0,"one legitimately gathered berry is set aside once")
 L.observe(home,"harvest",{"crop":"strawberry"})
 check(home.life.arcs.baking==2 and home.neighborhood.produce.strawberry==0,"replayed ingredient observation cannot underflow inventory")
 L.observe(home,"meal",{"recipe":"cloud_pancakes"})
 check(home.life.arcs.baking==2,"the special treat uses its actual recipe")
 L.observe(home,"meal",{"recipe":"berry_cupcakes"})
 check(home.life.arcs.baking==3,"actual cupcakes advance the next chapter")
 L.activity(home,"tea","mimi","berry")
 check(home.life.arcs.baking==4 and "baking" in home.life.rewards and home.coins==8,"shared tea concludes the full baking story with one permanent reward")
 var xp: int=home.neighborhood.people.mimi.xp
 for i in range(5): L.activity(home,"tea","mimi","lavender")
 check(home.coins==8 and home.neighborhood.people.mimi.xp==xp,"repeat shared activities cannot duplicate story coins or friendship")
 check(home.life.tea_choice=="lavender","a repeat tea choice has a persistent visible blend distinction")
 L.activity(home,"picnic","mimi","clouds")
 check(home.neighborhood.people.mimi.xp==xp,"tea and picnic share the same person/day bonus cap")
 check(home.life.picnic_choice=="clouds","picnic choice keeps a real outcome distinction")
 home.day+=1;L.activity(home,"help","mimi","care")
 check(home.neighborhood.people.mimi.xp==xp+1,"a later in-game day permits a legitimate shared activity benefit")
 check(L.begin(home,"garden"),"Noah can begin his own independent story")
 for step in [["plant","carrot"],["plant","lavender"],["garden_water","lavender"],["harvest","carrot"],["harvest","lavender"]]: L.observe(home,step[0],{"crop":step[1]})
 check(home.life.arcs.garden==4,"Noah requires planting, watering and harvesting lavender in order")
 L.activity(home,"help","noah","care")
 check(home.life.arcs.garden==5 and "garden" in home.life.rewards and home.coins==16,"garden help concludes Noah's four-step story")
 home.neighborhood.people.noah.met=true
 check(L.begin(home,"warming"),"both met friends and a completed personal story unlock housewarming")
 L.observe(home,"meal",{"recipe":"starry_soup"})
 L.activity(home,"picnic","mimi","stories",false)
 check(home.life.arcs.warming==2,"one visitor cannot substitute for a physical gathering")
 L.activity(home,"picnic","mimi","stories",true)
 check(home.life.arcs.warming==3,"a shared picnic with both friends advances gathering preparation")
 L.observe(home,"toast",{"both":true})
 check(home.life.arcs.warming==4 and "warming" in home.life.rewards and home.coins==24,"a real group toast concludes housewarming")
 for i in range(3): L.observe(home,"toast",{"both":true})
 check(home.coins==24 and home.life.rewards.size()==3,"all three memories have durable single-award receipts")
 home.neighborhood.people.noah.xp=12;home.day+=1
 L.activity(home,"picnic","noah","clouds")
 check(home.neighborhood.people.noah.xp==12,"shared activity cannot exceed existing friendship cap")
 var clone: Dictionary=H.sanitize(home)
 check(clone.life==home.life,"all story chapters, choices and receipts survive sanitize round trip")
 home.life.earned=17;L.finish_day(home)
 check(home.life.last_summary.earned==17 and home.life.last_summary.stories.size()==3,"compact summary keeps earned coins and permanent memories")
 check(home.life.day_log.is_empty() and home.life.earned==0,"next-day summary counters reset without resetting permanent progress")
 var malformed:=L.sanitize({"arcs":{"baking":999,"garden":-1},"rewards":["baking","baking","fake"],"activity_days":{"mimi.tea":-2},"tea_choice":"fake","earned":-90,"future":{"kept":42}})
 check(malformed.arcs.baking==4 and malformed.arcs.garden==0 and malformed.rewards==["baking"],"invalid and duplicate story values are bounded")
 check(malformed.tea_choice=="berry" and malformed.earned==0 and malformed.future.kept==42,"malformed choices default while additive future fields survive")
 check(L.sanitize({"last_summary":{"day":"bad","friends":[]}}).last_summary.is_empty(),"malformed end-of-day summary cannot reach UI with missing fields")
 var bounded: Dictionary=L.sanitize({"last_summary":{"day":2,"earned":-9,"friends":{"mimi":999,"noah":-1},"garden":90,"stories":["fake","baking"],"moments":[34,"A real memory"]}}).last_summary
 check(bounded.earned==0 and bounded.friends=={"mimi":12,"noah":0} and bounded.garden==3 and bounded.stories==["baking"] and bounded.moments==["A real memory"],"summary fields and authored memories are safely bounded")
 for day in range(1,41):
  home.day=day;N.new_day(home)
  check(home.neighborhood.daily_goals.size()==3 and home.neighborhood.daily_goals.all(func(id): return id in H.goal_definitions()),"three valid objectives remain available on day "+str(day))
 print("COZY STORY RULES: ",checks-failures,"/",checks);quit(1 if failures else 0)
